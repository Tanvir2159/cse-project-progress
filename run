#!/usr/bin/env bash
set -e

cd "$(dirname "$0")"

if command -v make >/dev/null 2>&1; then
    make project
elif command -v mingw32-make >/dev/null 2>&1; then
    mingw32-make project
fi

TARGET="./gamehub"
if [ ! -f "$TARGET" ] && [ -f "./gamehub.exe" ]; then
    TARGET="./gamehub.exe"
fi

exec "$TARGET" "$@"
